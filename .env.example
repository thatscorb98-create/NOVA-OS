# NOVA OS — public cloud configuration.
#
# Copy this file to `.env` and fill in your own project values. `.env` is
# gitignored; this example file is committed on purpose.
#
# These two values are PUBLIC by design (they ship inside the app bundle).
# Every table is protected by row level security, so the anon key can only
# read and write rows owned by the signed-in user.
#
# NEVER put a service-role key, Stripe secret key or NVIDIA key here.
# Server-only secrets belong in Supabase → Edge Functions → Secrets.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
